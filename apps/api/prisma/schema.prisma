generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id                     String        @id                               @default(uuid())
  email                  String        @unique
  passwordHash           String        @map("password_hash")
  username               String?       @unique
  displayName            String?       @map("display_name")
  birthDate              DateTime?     @map("birth_date") @db.Date
  avatarUrl              String?       @map("avatar_url")
  profileCompletedAt     DateTime?     @map("profile_completed_at")
  createdAt              DateTime      @default(now())                  @map("created_at")
  deletedAt              DateTime?     @map("deleted_at")

  threadsAsLow Thread[] @relation("ThreadUserLow")
  threadsAsHigh Thread[] @relation("ThreadUserHigh")
  messagesSent Message[]

  @@map("users")
}

model Thread {
  id String @id @default(uuid())
  userLowId String @map("user_low_id")
  userHighId String @map("user_high_id")
  createdAt DateTime @default(now()) @map("created_at")

  userLow User @relation("ThreadUserLow", fields: [userLowId], references: [id])
  userHigh User @relation("ThreadUserHigh", fields: [userHighId] , references: [id])
  messages Message[]

  @@unique([userLowId , userHighId])
  @@map("threads")
}

model Message {
  id String @id @default(uuid())
  threadId String @map("thread_id")
  senderId String @map("sender_id")
  body String
  createdAt DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@map("messages")
}