#Database - (PostgreSQL in Docker - see docker.compose.yml)
DATABASE_URL=postgresql://panchat:panchat@localhost:5433/panchat

#API
API_HOST=0.0.0.0
API_PORT=4000

# Frontend URL(s) for CORS — comma-separated for laptop + phone LAN testing:
# WEB_ORIGIN=http://192.168.1.5:5173,http://localhost:5173
WEB_ORIGIN=http://localhost:5173

#Auth
JWT_SECRET=change-me-in-development-use-long-random-string-in-production
# API_PUBLIC_URL=http://localhost:4000
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Production (web on Vercel, API on Railway — different domains):
# COOKIE_CROSS_SITE=true
# TRUST_PROXY=true

NODE_ENV=development

# Rate limiting (API)
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=15

# Password reset email
# REQUIRED in production (NODE_ENV=production) — reset links go only to the inbox.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=PanChat <noreply@yourdomain.com>

# Local dev only: show reset link in the browser (default: API terminal only).
# Never enable on a shared machine or deployed server.
# EXPOSE_DEV_RESET_LINK_IN_UI=true
# EXPOSE_DEV_VERIFY_LINK_IN_UI=true